# API key Claude dari https://console.anthropic.com
# Kosong = web tetap bisa dipakai (daftar, masuk, simpan kreator), hanya fitur generate yang nonaktif.
ANTHROPIC_API_KEY=

# Database Postgres (Neon / Supabase dari Vercel Marketplace otomatis mengisi ini).
# Kosong = pakai SQLite lokal di data/kerang.db.
DATABASE_URL=

# Opsional
# KERANG_MODEL=claude-opus-5
# KERANG_EFFORT=high
# KERANG_MOCK=1   (mode demo: respons contoh tanpa memanggil API)
# KERANG_DB=./data/kerang.db
# PORT=3000
